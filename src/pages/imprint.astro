---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Imprint  SilTest Semiconductors" description="Legal information and imprint for SilTest Semiconductors GmbH.">
  <Header />
  <section class="hero"><div class="wrap"><div class="rv in"><span class="eyebrow">Legal</span><h1>Imprint</h1></div></div></section>
  <section style="padding-top:0"><div class="wrap legal rv">
    <div class="flag">Draft. Please fill the items marked [PLACEHOLDER] with your registered legal details and have this reviewed before launch.</div>
    <h2>Information pursuant to Section 5 TMG</h2>
    <p>SilTest Semiconductors GmbH<br />
    [PLACEHOLDER: registered street and number]<br />
    Technologie-Zentrum Kleve<br />
    [PLACEHOLDER: postal code] Kleve, Germany</p>
    <h2>Represented by</h2>
    <p>Sameer Saran, Managing Director</p>
    <h2>Contact</h2>
    <p>Email: <a href="mailto:info@siltest.com">info@siltest.com</a><br />
    Phone: [PLACEHOLDER: phone number]</p>
    <h2>Register entry</h2>
    <p>Registered at: [PLACEHOLDER: Amtsgericht / register court]<br />
    Registration number: [PLACEHOLDER: HRB number]</p>
    <h2>VAT identification number</h2>
    <p>VAT ID pursuant to Section 27a of the German VAT Act: [PLACEHOLDER: DE VAT ID]</p>
    <h2>Responsible for content pursuant to Section 55 (2) RStV</h2>
    <p>Sameer Saran, address as above.</p>
    <h2>Disclaimer</h2>
    <p>Despite careful control of the content, we assume no liability for the content of external links. The operators of the linked pages are solely responsible for their content.</p>

  </div></section>
  <Footer />
</Base>
