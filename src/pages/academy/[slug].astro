---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { courses } from "../../data/courses.js";

export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } }));
}
const { course } = Astro.props;
const enr = course.enrolment;

const schema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: course.title,
  description: course.overview,
  provider: { "@type": "Organization", name: "SilTest Academy", url: "https://siltest.com/academy" },
  ...(enr?.open && {
    hasCourseInstance: {
      "@type": "CourseInstance",
      courseMode: "online",
      startDate: "2026-08-03",
      endDate: "2026-08-04",
      offers: { "@type": "Offer", price: enr.price, priceCurrency: enr.currency, availability: "https://schema.org/InStock" },
    },
  }),
};
---
<Base title={`${course.title}  SilTest Academy`} description={course.overview}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="rv in" style="max-width:840px">
        <a class="backlink" href="/academy">&larr; SilTest Academy</a>
        {enr?.open
          ? <span class="enrol-flag"><i></i> Enrolment open  ·  {enr.dateShort}</span>
          : <span class="eyebrow">Course {course.num}{course.upcoming ? "  ·  dates soon" : ""}</span>}
        <h1>{course.title}</h1>
        <p class="subhead">{course.tagline}</p>
        <p class="lead">{course.overview}</p>
        {enr?.open && (
          <div class="enrol-strip">
            <div><span>Dates</span><b>{enr.dateLabel}</b></div>
            <div><span>Each day</span><b>{enr.time}</b></div>
            <div><span>Format</span><b>{enr.delivery}</b></div>
            <div><span>Seat price</span><b>{enr.currency} {enr.price}</b></div>
          </div>
        )}
        <div class="hero-cta">
          {enr?.open
            ? <a class="btn btn-p" href="#enrol">Book your seat</a>
            : <a class="btn btn-p" href="/contact">Register for dates and pricing</a>}
          <a class="btn btn-o" href="/academy">All courses</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AT A GLANCE -->
  <section style="padding-top:0">
    <div class="wrap">
      <div class="glance rv">
        <div><div class="gl">Duration</div><div class="gv">{course.glance.duration}</div></div>
        <div><div class="gl">Format</div><div class="gv">{course.glance.format}</div></div>
        <div><div class="gl">Delivery</div><div class="gv">{course.glance.delivery}</div></div>
        <div><div class="gl">Language</div><div class="gv">{course.glance.language}</div></div>
      </div>
    </div>
  </section>

  <!-- WHO + OBJECTIVES -->
  <section class="why">
    <div class="wrap svc-two">
      <div class="rv">
        <div class="collbl">Who it is for</div>
        <ul class="caps">{course.audience.map((a) => <li>{a}</li>)}</ul>
      </div>
      <div class="rv">
        <div class="collbl">What you will learn</div>
        <ul class="caps">{course.objectives.map((o) => <li>{o}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- CURRICULUM -->
  <section>
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">Curriculum</span><h2>What the course covers</h2></div>
      <div class="curric">
        {course.curriculum.map((m) => (
          <div class="cmod rv">
            <div class="cmh">{m.title}</div>
            <ul>{m.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {course.deliverables && (
    <section class="why">
      <div class="wrap">
        <div class="sec-head rv"><span class="eyebrow">You take away</span><h2>What you leave with</h2></div>
        <ul class="caps rv" style="max-width:760px">{course.deliverables.map((d) => <li>{d}</li>)}</ul>
      </div>
    </section>
  )}

  <!-- INSTRUCTOR + CERTIFICATE -->
  <section>
    <div class="wrap split">
      <div class="panel rv">
        <span class="eyebrow">Who teaches it</span>
        <h3>Taught by working engineers</h3>
        <p>{course.instructor}</p>
      </div>
      <div class="panel rv">
        <span class="eyebrow">What you earn</span>
        <h3>A certificate that counts</h3>
        <p>{course.certificate}</p>
      </div>
    </div>
  </section>

  {enr?.open && (
    <section id="enrol" class="why">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="eyebrow">Enrolment</span>
          <h2>Book your seat</h2>
          <p>The next session runs {enr.dateLabel}, {enr.time} on both days, {enr.delivery.toLowerCase()}. Seats are limited so the group stays small enough for discussion.</p>
        </div>

        <div class="enrol-grid">
          <div class="enrol-card feat rv">
            <div class="ec-tag">Individual seat</div>
            <div class="ec-price">{enr.currency} {enr.price}<small>{enr.priceNote}</small></div>
            <ul class="ec-list">{enr.includes.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn-p ec-btn" href={enr.checkout}>Book and pay your seat</a>
            <div class="ec-foot">Prices exclude VAT. Secure checkout by Stripe, which collects your name, company and contact details. Joining instructions follow by email once payment clears.</div>
          </div>

          <div class="enrol-card rv">
            <div class="ec-tag">Groups and corporate</div>
            <div class="ec-price alt">Let us scope it<small>tailored to your team</small></div>
            <ul class="ec-list">
              <li>Reduced per-seat pricing for several colleagues</li>
              <li>A private session for your team, on your own workflows</li>
              <li>Delivered online, or on-site at your company</li>
              <li>Dates arranged around your project schedule</li>
            </ul>
            <a class="btn btn-o ec-btn" href="/contact">Ask for group pricing</a>
            <div class="ec-foot">Or write to <a href="mailto:info@siltest.com">info@siltest.com</a> and we will come back with a quote.</div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="why">
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">Questions</span><h2>Good to know</h2></div>
      <div class="faq rv">
        {course.faq.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap">
      <h2 class="rv">{enr?.open ? "Seats are open for the next session" : "Join this course"}</h2>
      <p class="rv">{enr?.open
        ? `The next session runs ${enr.dateLabel}. Book a seat, or ask us about pricing for your team.`
        : "Register your interest and we will send you the next dates, the price, and everything you need."}</p>
      <div class="cta-row rv">
        {enr?.open
          ? <a class="btn btn-w" href={enr.checkout}>Book your seat</a>
          : <a class="btn btn-w" href="/contact">Register for details</a>}
        <a class="btn btn-o" style="color:#fff;border-color:rgba(255,255,255,.3)" href="/academy">Back to Academy</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
