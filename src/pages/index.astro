---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="SilTest Semiconductors  AI tools for chip testing and production"
  description="SilTest builds and licenses AI tools that make semiconductor chip testing and production faster and less manual. VISTAR AI platform, YieldOptiX, DefectOptiX, and STDF Quick Viewer."
>
  <Header />

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="rv in">
        <span class="eyebrow">AI tools for chip test and production</span>
        <h1>AI tools that make chip testing <span>faster</span>.</h1>
        <p class="lead">SilTest builds and licenses AI tools that cut the manual work in semiconductor test and production. VISTAR, our AI platform, plus focused tools for analytics, quality, and data.</p>
        <div class="hero-cta">
          <a class="btn btn-p" href="/contact">Book a demo</a>
          <a class="btn btn-o" href="#tools">Explore the tools</a>
        </div>
        <div class="hero-note">On-prem or private cloud. Built on open-source language models.</div>
      </div>
      <div class="rv in">
        <div class="flow">
          <div class="flow-bar"><span>vistar // pipeline</span><span class="dots"><i></i><i></i><i></i></span></div>
          <div class="flow-row">
            <div class="node"><div class="lab">Input</div><ul><li>test program</li><li>STDF data</li><li>debug logs</li></ul></div>
            <div class="engine"><div class="core"></div><div class="nm">VISTAR</div><div class="sub">generative<br />and agentic AI</div></div>
            <div class="node"><div class="lab">Output</div><ul><li>new program</li><li>yield insight</li><li>root cause</li></ul></div>
          </div>
          <div class="flow-foot"><span>runs on your infrastructure</span><span class="ok">data stays with you</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <div class="trust">
    <div class="wrap trust-in">
      <div class="affil">
        <div class="card"><img src="/logos/qstp.jpg" alt="Qatar Science and Technology Park" /><span class="cap">Incubated at QSTP</span></div>
        <div class="card"><img src="/logos/excitelab.png" alt="ExciteLab" /><span class="cap">High-Tech Accelerator Alumni</span></div>
      </div>
      <div class="plats">
        <span class="lbl">Works with</span>
        <span class="chip">Advantest</span>
        <span class="chip">Teradyne</span>
        <span class="chip">NI</span>
        <span class="chip">Eagle ETS</span>
        <span class="chip more">+ more on request</span>
      </div>
    </div>
  </div>

  <!-- VISTAR -->
  <section class="vistar">
    <div class="wrap vgrid">
      <div class="rv">
        <span class="eyebrow">The platform</span>
        <h2>VISTAR</h2>
        <p class="v">VISTAR is our AI platform for chip test and production. It combines an analytical engine with generative and agentic AI, built on open-source language models, and runs on-prem or in your private cloud so your data stays with you.</p>
        <div class="vtags"><span class="vtag">analytical engine</span><span class="vtag">generative AI</span><span class="vtag">agentic AI</span><span class="vtag">open-source LLMs</span></div>
        <a class="link-arrow" href="/vistar" style="color:var(--lightblue)">Explore VISTAR <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a>
      </div>
      <div class="rv modules">
        <div class="mod"><span class="mi">01</span><div><b>Test Program Generator</b><p>Generate test programs for Advantest and Teradyne from your inputs.</p></div></div>
        <div class="mod"><span class="mi">02</span><div><b>AutoMigreX</b><p>Convert programs across platforms, SmarTest 7 to 8, ETS364 to ETS800, and cross-platform.</p></div></div>
        <div class="mod"><span class="mi">03</span><div><b>SighFiX</b><p>Silicon and board debug assistant, powered by the VISTAR engine.</p></div></div>
        <div class="mod-more">More modules are on the way.</div>
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section id="tools">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow">Standalone tools</span>
        <h2>Focused tools you can use today</h2>
        <p>Each one solves a real job on its own. Use them alone, or bring them into VISTAR.</p>
      </div>
      <div class="tools-grid">
        <div class="tool rv">
          <span class="tname">YieldOptiX</span>
          <div class="tout">The world's most powerful JMP plugin</div>
          <div class="tdesc">Advanced ML analytics for test data, from bring-up to high volume. Run it in JMP, or by natural-language prompt inside VISTAR.</div>
          <div class="tfoot"><a class="link-arrow" href="/yieldoptix">See YieldOptiX <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a></div>
        </div>
        <div class="tool rv">
          <span class="tname">DefectOptiX</span>
          <div class="tout">Know your outgoing ppm, and defend it</div>
          <div class="tdesc">Turn test and process parameters into a modelled outgoing quality figure your auditors can trust, with a costed path to your target.</div>
          <div class="tfoot"><a class="link-arrow" href="/defectoptix">See DefectOptiX <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a></div>
        </div>
        <div class="tool rv">
          <span class="tname">STDF Quick Viewer</span>
          <div class="tout">Open any STDF file in your browser</div>
          <div class="tdesc">Parametric summary, wafer maps, and yield in seconds. No license, no install. Your data never leaves your computer.</div>
          <div class="tfoot"><a class="link-arrow" href="/stdf-quick-viewer">Try it free <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a><span class="badge">From EUR 0</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why">
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">Why teams use them</span><h2>Less manual work, faster answers</h2></div>
      <div class="why-grid">
        <div class="tile rv"><div class="n">/ 01</div><h3>Less manual work</h3><p>Generate and convert test programs instead of writing them by hand.</p></div>
        <div class="tile rv"><div class="n">/ 02</div><h3>Catch problems earlier</h3><p>Find failing patterns and root causes in the data, not in the field.</p></div>
        <div class="tile rv"><div class="n">/ 03</div><h3>Faster yield decisions</h3><p>Go from raw STDF to clear answers in minutes.</p></div>
        <div class="tile rv"><div class="n">/ 04</div><h3>Move across platforms</h3><p>Convert programs between Advantest and Teradyne without starting over.</p></div>
      </div>
    </div>
  </section>

  <!-- MARKETS -->
  <section>
    <div class="wrap">
      <div class="sec-head rv">
        <span class="eyebrow">Where it is used</span>
        <h2>Built for where testing is heading</h2>
        <p>Our tools work on the same test data, programs, and documents, whatever the chip is for. So they serve every sector without changing how they work.</p>
      </div>
      <div class="mk-grid rv">
        <div class="mkcard lead"><div class="mkdot"></div><div class="mkname">Data Center and Networking</div><div class="mkdesc">High-speed compute and switching silicon, where volume and quality both scale fast.</div></div>
        <div class="mkcard lead"><div class="mkdot"></div><div class="mkname">AI</div><div class="mkdesc">Accelerators and high-performance parts with large test programs and heavy data.</div></div>
        <div class="mkcard"><div class="mkdot"></div><div class="mkname">Photonics</div><div class="mkdesc">Optical and mixed optical-electronic devices that still produce standard test data.</div></div>
        <div class="mkcard"><div class="mkdot"></div><div class="mkname">Defense and Aerospace</div><div class="mkdesc">High-reliability parts where every unit has to be traceable and screened.</div></div>
        <div class="mkcard"><div class="mkdot"></div><div class="mkname">Automotive</div><div class="mkdesc">Safety-critical silicon at automotive grade, from ADAS to power.</div></div>
      </div>
    </div>
  </section>

  <!-- SERVICES + ACADEMY -->
  <section class="why">
    <div class="wrap split">
      <div class="panel rv">
        <span class="eyebrow">Beyond the tools</span>
        <h3>Engineers who work alongside your team</h3>
        <p>When you need hands on the problem, our team delivers test engineering, design for test, hardware, packaging and qualification, and yield management.</p>
        <a class="link-arrow" href="/services">See services <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a>
      </div>
      <div class="panel rv">
        <span class="eyebrow">Learn</span>
        <h3>SilTest Academy</h3>
        <p>Training in semiconductors and ATE, in Kleve or on-site, with a certificate on completion.</p>
        <a class="link-arrow" href="/academy">See the Academy <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a>
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="cta">
    <div class="wrap">
      <h2 class="rv">See the tools on your own data</h2>
      <p class="rv">Book a demo and we will show VISTAR and the tools with your test cases.</p>
      <div class="cta-row rv"><a class="btn btn-w" href="/contact">Book a demo</a><a class="btn btn-o" style="color:#fff;border-color:rgba(255,255,255,.3)" href="/contact">Talk to us</a></div>
      <div class="news rv"><input type="email" placeholder="Your work email" /><a class="btn btn-p" href="/contact">Keep me posted</a></div>
    </div>
  </section>

  <Footer />
</Base>
