---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---
<Base
  title="SilTest Semiconductors  KI-Werkzeuge fuer Chip-Test und Produktion"
  description="SilTest entwickelt und lizenziert KI-Werkzeuge fuer den Halbleiter-Test."
  lang="de"
>
  <Header />
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Bald verfuegbar</span>
      <h1 style="margin-top:1rem">Die deutsche Version folgt.</h1>
      <p class="lead" style="margin-top:1rem">Diese Seite ist fuer die deutsche Uebersetzung vorbereitet. Struktur und hreflang sind bereits eingerichtet.</p>
      <div class="hero-cta" style="margin-top:1.5rem"><a class="btn btn-p" href="/">English site</a></div>
    </div>
  </section>
  <Footer />
</Base>
