---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="About SilTest Semiconductors  engineers who deliver"
  description="SilTest is an AI-first semiconductor company. We build and license AI tools for chip test and production, and our engineers work alongside your team, from design debug to high-volume ramp."
>
  <Header />

  <section class="hero">
    <div class="wrap">
      <div class="rv in" style="max-width:860px">
        <span class="eyebrow">About SilTest</span>
        <h1>We engineer solutions that accelerate chip success</h1>
        <p class="lead">SilTest is an AI-first semiconductor company. We build and license AI tools that make chip test and production faster and less manual, and when a problem needs hands, our engineers work right alongside your team. We join your team and work like part of it.</p>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="why">
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">How we work</span><h2>Engineer to engineer</h2><p>From design debug to high-volume ramp, we tailor test strategies built around your product. We call it engineer-to-engineer delivery: shared responsibility, agility, and real domain depth.</p></div>
      <div class="cap3" style="grid-template-columns:repeat(4,1fr)">
        <div class="capcard rv"><div class="ci">Customer focus</div><h3>We integrate</h3><p>We adapt to your flow and deliver fast, inside your engineering workflows.</p></div>
        <div class="capcard rv"><div class="ci">Technical trust</div><h3>By engineers</h3><p>Built by engineers, for engineers, with people who have done the job.</p></div>
        <div class="capcard rv"><div class="ci">Quality</div><h3>No compromise</h3><p>Every test, every board, every time. Quality is the default.</p></div>
        <div class="capcard rv"><div class="ci">Scalability</div><h3>One to thousands</h3><p>From a single device to high volume, without friction.</p></div>
      </div>
    </div>
  </section>

  <!-- FOUNDER QUOTE -->
  <section>
    <div class="wrap">
      <div class="quote-block rv">
        <img src="/media/team/sameer-saran.jpg" alt="Sameer Saran" />
        <div>
          <div class="q">&ldquo;SilTest was built to solve the post-silicon problems no one else wants to touch. We are engineers who deliver.&rdquo;</div>
          <div class="qa">Sameer Saran, Founder and CEO</div>
          <div style="margin-top:1.2rem"><a class="btn btn-p" href="/leadership">Meet the team</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section class="why">
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">What we do</span><h2>ATE expertise, connected to real yield results</h2><p>We focus on the real-world problems that appear after first silicon, and we bring AI to bear on them.</p></div>
      <div class="cap3">
        <div class="capcard rv"><div class="ci">The tools</div><h3>AI-first products</h3><p>VISTAR, YieldOptiX, DefectOptiX, and STDF Quick Viewer: AI tools that speed up test program work, root cause, and outgoing quality. <a class="link-arrow" href="/">See the tools <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a></p></div>
        <div class="capcard rv"><div class="ci">The services</div><h3>Post-silicon engineering</h3><p>Test program development, debug, ATE correlation, and the hardware behind it: probe cards, load boards, substrates, and HTOL. <a class="link-arrow" href="/services">See services <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a></p></div>
        <div class="capcard rv"><div class="ci">The academy</div><h3>Skills that scale</h3><p>Hands-on, engineer-led training that helps teams grow real test capability on real equipment. <a class="link-arrow" href="/academy">See the Academy <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></a></p></div>
      </div>
    </div>
  </section>

  <!-- IMPACT STATS -->
  <section>
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">Our impact</span><h2>A track record you can build on</h2></div>
      <div class="stats-band rv">
        <div class="stat-item"><div class="snum">3</div><div class="slab">engineering hubs across Europe, the Middle East, and India</div></div>
        <div class="stat-item"><div class="snum">4+</div><div class="slab">countries served</div></div>
        <div class="stat-item"><div class="snum">30+</div><div class="slab">product ramps supported</div></div>
        <div class="stat-item"><div class="snum">3</div><div class="slab">engineering hubs worldwide</div></div>
      </div>
    </div>
  </section>

  <!-- WHERE WE ARE -->
  <section class="why">
    <div class="wrap">
      <div class="sec-head rv"><span class="eyebrow">Where to find us</span><h2>Three engineering hubs</h2></div>
      <div class="cap3">
        <div class="capcard rv"><div class="ci">Germany</div><h3>Kleve</h3><p>Headquarters, engineering, and the SilTest Academy.</p></div>
        <div class="capcard rv"><div class="ci">Qatar</div><h3>Doha</h3><p>Engineering and regional work, at Qatar Science and Technology Park.</p></div>
        <div class="capcard rv"><div class="ci">India</div><h3>Bangalore</h3><p>Engineering, close to a deep pool of test and design talent.</p></div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2 class="rv">Let us solve it together</h2>
      <p class="rv">Whether you need the tools, the engineers, or the training, we would like to hear from you.</p>
      <div class="cta-row rv"><a class="btn btn-w" href="/contact">Talk to us</a><a class="btn btn-o" style="color:#fff;border-color:rgba(255,255,255,.3)" href="/">See the tools</a></div>
    </div>
  </section>

  <Footer />
</Base>
