---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { posts } from "../../data/posts.js";
const sorted = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const [lead, ...rest] = sorted;
---
<Base
  title="News and insights  SilTest Semiconductors"
  description="Company news, partnerships, and engineering notes from SilTest Semiconductors: semiconductor test, yield analytics, and AI tools for production.">
  <Header />

  <section class="hero">
    <div class="wrap">
      <div class="rv in" style="max-width:820px">
        <span class="eyebrow">News and insights</span>
        <h1>What we are building, and what we are learning.</h1>
        <p class="lead">Company announcements, partnerships, and notes from the test floor.</p>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <a class="postlead rv" href={`/news/${lead.slug}`}>
        {lead.image && <div class="pl-img"><img src={lead.image} alt={lead.imageAlt} loading="lazy" /></div>}
        <div class="pl-body">
          <div class="pmeta"><span class="pcat">{lead.category}</span><span>{lead.dateLabel}</span><span>{lead.readingTime}</span></div>
          <h2>{lead.title}</h2>
          <p>{lead.excerpt}</p>
          <span class="link-arrow">Read the story <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></span>
        </div>
      </a>

      <div class="postgrid">
        {rest.map((p) => (
          <a class="postcard rv" href={`/news/${p.slug}`}>
            {p.image
              ? <div class="pc-img"><img src={p.image} alt={p.imageAlt} loading="lazy" /></div>
              : <div class="pc-img pc-abstract"><span>{p.category}</span></div>}
            <div class="pc-body">
              <div class="pmeta"><span class="pcat">{p.category}</span><span>{p.dateLabel}</span></div>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
              <span class="link-arrow">Read more <svg width="15" height="11" viewBox="0 0 16 12" fill="none"><path d="M1 6h13M9 1l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Base>
