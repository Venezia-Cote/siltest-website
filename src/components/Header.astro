---
// Shared site header. Nav is data-driven so pages stay consistent.
const products = [
  { name: "VISTAR", note: "AI platform for test and production", href: "/vistar" },
  { name: "YieldOptiX", note: "ML analytics for test data", href: "/yieldoptix" },
  { name: "STDF Quick Viewer", note: "Open any STDF file, free", href: "/stdf-quick-viewer" },
  { name: "DefectOptiX", note: "Outgoing quality estimator", href: "/defectoptix" },
  { name: "CertOptiX", note: "Cut compliance workload", href: "/certoptix" },
];
const services = [
  { name: "Design for Test", href: "/services#design-for-test" },
  { name: "Hardware Design", href: "/services#hardware-design" },
  { name: "Test Engineering", href: "/services#test-engineering" },
  { name: "Packaging and Qualification", href: "/services#packaging-qualification" },
  { name: "Yield Management", href: "/services#yield-management" },
];
const company = [
  { name: "About", href: "/about" },
  { name: "Leadership", href: "/leadership" },
  { name: "Partnerships", href: "/partnerships" },
  { name: "News and insights", href: "/news" },
  { name: "Career", href: "/career" },
];
---
<header>
  <div class="wrap nav">
    <a class="brand" href="/"><img src="/logos/wordmark.png" alt="SilTest Semiconductors" /></a>
    <nav class="nav-links">
      <div class="nav-item">
        <span>Products <svg class="caret" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4"/></svg></span>
        <div class="menu">
          {products.map((p) => (
            <a href={p.href}><b>{p.name}</b><span>{p.note}</span></a>
          ))}
        </div>
      </div>
      <div class="nav-item">
        <span>Services <svg class="caret" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4"/></svg></span>
        <div class="menu">
          {services.map((s) => (<a href={s.href}><b>{s.name}</b></a>))}
        </div>
      </div>
      <div class="nav-item"><a href="/academy">Academy</a></div>
      <div class="nav-item">
        <span>Company <svg class="caret" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4"/></svg></span>
        <div class="menu">
          {company.map((c) => (<a href={c.href}><b>{c.name}</b></a>))}
        </div>
      </div>
    </nav>
    <div class="nav-right">
      <a class="btn btn-p" href="/contact">Book a demo</a>
    </div>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav" type="button">Menu</button>
  </div>
  </header>

  <!-- Mobile menu, kept outside <header> so the header backdrop-filter does not trap it -->
  <div class="mobnav" id="mobileNav" hidden>
    <div class="mobnav-group">
      <div class="mobnav-label">Products</div>
      {products.map((p) => (<a href={p.href}>{p.name}</a>))}
    </div>
    <div class="mobnav-group">
      <div class="mobnav-label">Services</div>
      {services.map((s) => (<a href={s.href}>{s.name}</a>))}
    </div>
    <div class="mobnav-group">
      <div class="mobnav-label">Academy</div>
      <a href="/academy">All courses</a>
    </div>
    <div class="mobnav-group">
      <div class="mobnav-label">Company</div>
      {company.map((c) => (<a href={c.href}>{c.name}</a>))}
    </div>
    <a class="btn btn-p mobnav-cta" href="/contact">Book a demo</a>
  </div>

<script is:inline>
  (function () {
    var b = document.getElementById("burger");
    var m = document.getElementById("mobileNav");
    if (!b || !m) return;
    var header = b.closest("header");
    function syncOffset() {
      if (header) document.documentElement.style.setProperty("--nav-h", header.offsetHeight + "px");
    }
    function setOpen(open) {
      syncOffset();
      m.hidden = !open;
      b.setAttribute("aria-expanded", open ? "true" : "false");
      b.textContent = open ? "Close" : "Menu";
      document.body.style.overflow = open ? "hidden" : "";
    }
    window.addEventListener("resize", function () { if (!m.hidden) syncOffset(); });
    b.addEventListener("click", function () {
      setOpen(m.hidden);
    });
    // close when a link is tapped, or on escape
    m.addEventListener("click", function (e) {
      if (e.target.closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !m.hidden) setOpen(false);
    });
  })();
</script>
