---
export interface Props {
  title: string;
  description: string;
  lang?: string;
  noindex?: boolean;
  ogImage?: string;
  breadcrumbLastLabel?: string;
}
const {
  title,
  description,
  lang = "en",
  noindex = false,
  ogImage = "/media/og-default.png",
  breadcrumbLastLabel,
} = Astro.props;
const absoluteOgImage = new URL(ogImage, "https://siltest.com").href;
const canonicalUrl = new URL(Astro.url.pathname, "https://siltest.com").href;
// German is not live yet. Until real content ships, do not tell search engines
// or hreflang that /de/ is a valid alternate: it is a placeholder page.
const germanIsLive = false;
import "../styles/global.css";

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SilTest Semiconductors",
  url: "https://siltest.com",
  logo: "https://siltest.com/logos/lockup.png",
  email: "info@siltest.com",
  description:
    "SilTest builds and licenses AI tools that make semiconductor chip testing and production faster and less manual.",
  address: [
    { "@type": "PostalAddress", addressLocality: "Kleve", addressCountry: "DE" },
    { "@type": "PostalAddress", addressLocality: "Doha", addressCountry: "QA" },
    { "@type": "PostalAddress", addressLocality: "Bangalore", addressCountry: "IN" },
  ],
};

// Breadcrumb schema, built from the URL path. Product and section slugs get
// their real display name; anything else falls back to a title-cased
// version of the slug. Skipped on the homepage and on noindex pages, where
// a breadcrumb trail adds nothing.
const segmentNames: Record<string, string> = {
  vistar: "VISTAR",
  yieldoptix: "YieldOptiX",
  defectoptix: "DefectOptiX",
  certoptix: "CertOptiX",
  "stdf-quick-viewer": "STDF Quick Viewer",
  about: "About",
  academy: "Academy",
  career: "Career",
  contact: "Contact",
  imprint: "Imprint",
  privacy: "Privacy Policy",
  leadership: "Leadership and Team",
  partnerships: "Partnerships",
  services: "Services",
  news: "News and Insights",
};
const titleCase = (slug: string) =>
  slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
let breadcrumb: { "@context": string; "@type": string; itemListElement: object[] } | null = null;
if (!noindex && pathSegments.length > 0) {
  const items = [{ "@type": "ListItem", position: 1, name: "Home", item: "https://siltest.com/" }];
  let accPath = "";
  pathSegments.forEach((seg, i) => {
    accPath += `/${seg}`;
    const isLast = i === pathSegments.length - 1;
    const name = isLast && breadcrumbLastLabel ? breadcrumbLastLabel : segmentNames[seg] || titleCase(seg);
    items.push({
      "@type": "ListItem",
      position: i + 2,
      name,
      item: `https://siltest.com${accPath}/`,
    });
  });
  breadcrumb = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: items };
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- hreflang: only advertise a locale once it has real, live content. -->
    {germanIsLive ? (
      <>
        <link rel="alternate" hreflang="en" href="https://siltest.com/" />
        <link rel="alternate" hreflang="de" href="https://siltest.com/de/" />
        <link rel="alternate" hreflang="x-default" href="https://siltest.com/" />
      </>
    ) : (
      <link rel="alternate" hreflang="x-default" href="https://siltest.com/" />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content="SilTest Semiconductors" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <!-- Fonts are self-hosted from /fonts (see global.css @font-face).
         No connection to Google is made. Preload the two weights used
         above the fold so text paints without a flash. -->
    <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
        { threshold: 0.12 }
      );
      document.querySelectorAll(".rv").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
